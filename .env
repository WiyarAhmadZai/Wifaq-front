# API Base URL - Change this to your production backend URL when deploying
# For local development:
VITE_API_BASE_URL=http://localhost:8001/api
# VITE_API_BASE_URL=https://backend.wifaqschool.com/api

# For production (uncomment and update with your actual backend URL):
# VITE_API_BASE_URL=https://your-backend-domain.com/api

# ── Laravel Reverb (real-time chat WebSocket) ────────────────────────────────
# Must match the backend REVERB_* values. For local dev the Reverb server runs
# at 127.0.0.1:8080 (start it with `php artisan reverb:start` in the backend).
VITE_REVERB_APP_KEY=wifaqchatkey
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# In production point these at your public Reverb endpoint, e.g.:
# VITE_REVERB_HOST=chat.wifaqschool.com
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https

# ── Production build (vite build reads .env.production first) ────────────────
# Create a .env.production alongside this file with the PUBLIC values, e.g.
#   VITE_API_BASE_URL=https://backend.wifaqschool.com/api
#   VITE_REVERB_HOST=chat.wifaqschool.com
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
# Leaving VITE_REVERB_HOST at 127.0.0.1 in a production build disables live
# chat rather than looping on an impossible WebSocket (see src/chat/echo.js).
